rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write profile if owner or confirmed household member
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid in resource.data.get('householdMemberUids', [])
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Tasks subcollection — allowed if owner or household member
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.get('householdMemberUids', [])
        );
      }

      // Notifications subcollection — allowed if owner or household member
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.get('householdMemberUids', [])
        );
      }
    }

    // Public user code index for lookup by admin when adding members
    match /userCodes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Legacy public invite lookup for backward compatibility
    match /householdInvites/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // First-Class Households Entity Collection
    match /households/{householdId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.ownerUid
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.ownerUid ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.ownerUid ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid ||
        request.auth.uid in resource.data.memberUids
      );

      // Single Source of Truth Household Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids ||
          request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid
        );
      }
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message.size() <= 1000
        && request.resource.data.replies.size() == 0
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.status == 'open';
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      )
      && request.resource.data.replies.size() <= 30
      && (
        request.resource.data.replies.size() <= resource.data.replies.size() + 1
      )
      && (
        request.resource.data.replies.size() == resource.data.replies.size() ||
        request.resource.data.replies[request.resource.data.replies.size() - 1].message.size() <= 1000
      );
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Recommendations Campaigns
    match /recommendations/{recommendationId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks'])
      );
    }
  }
}
