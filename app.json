{
  "expo": {
    "name": "Repeto",
    "slug": "repeto",
    "version": "1.0.1",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/dc3bf5ae-77fe-4235-83b7-47a896e72430",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "repeto",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.repeto.tasks",
      "versionCode": 2,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "VIBRATE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-transparent.png",
          "backgroundColor": "#171B36"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#E8A33D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Repeto to use your camera to scan QR codes for household invites.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.android.gms.**\n-keep class io.invertase.firebase.** { *; }\n-dontwarn io.invertase.firebase.**\n-keep class com.repeto.tasks.alarm.** { *; }"
          }
        }
      ],
      "expo-audio",
      "./plugins/withAlarm.js",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc3bf5ae-77fe-4235-83b7-47a896e72430"
      }
    },
    "owner": "malaymahajan"
  }
}
